rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The whole site lives in one document. Anyone can read (the public site
    // renders from `published`); only the owner can write.
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'navaneethclpro@gmail.com';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
