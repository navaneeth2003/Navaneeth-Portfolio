# Supabase project — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Accounts allowed into /studio — comma-separated.
# Must match the email list in supabase/setup.sql.
NEXT_PUBLIC_OWNER_EMAILS=

# Resend API configuration for contact form emails (https://resend.com/api-keys)
RESEND_API_KEY=
# Optional: verified custom sender (defaults to "Portfolio Contact <onboarding@resend.dev>")
# RESEND_FROM_EMAIL=
# Optional: recipient email (defaults to your studio contact email or first owner email)
# CONTACT_TO_EMAIL=
